# Collaviah B2B Wholesale Environment Variables

# Sales Inbox Notification Recipient
SALES_NOTIFICATION_EMAIL=wholesale@collaviah.com

# Email Service Provider (Optional - defaults to simulated delivery in development if unset)
# RESEND_API_KEY=re_123456789
# EMAIL_FROM=COLLAVIAH Wholesale <quotes@collaviah.com>

# Webhook integration for CRM/Slack/Google Sheets (Optional)
# QUOTE_WEBHOOK_URL=https://hooks.slack.com/services/...

# Anti-abuse rate limit (Max requests per window)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# WhatsApp direct enquiry phone number (International format without + or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE=819012345678

